# Database
DATABASE_URL="postgresql://pdv_user:pdv_password@localhost:5432/pdv_db"

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRE=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Integrations
MERCADO_PAGO_TOKEN=your_mercado_pago_token
PAGSEGURO_TOKEN=your_pagseguro_token
STRIPE_SECRET_KEY=your_stripe_secret_key
ASSAAS_API_KEY=your_asaas_api_key
GERENCIANET_ID=your_gerencianet_id
GERENCIANET_TOKEN=your_gerencianet_token

# WhatsApp
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backup
BACKUP_INTERVAL=86400
BACKUP_PATH=./backups
